_count": 553, "playlist": "sun life insurance", "playlist_id": "sun life insurance", "playlist_title": "sun life insurance", "playlist_webpage_url": "ytsearchall:sun life insurance", "n_entries": 553, "playlist_index": 170, "display_id": "5QOZst9YbhY", "fulltitle": "Sun Life Investment Management targets 10% growth this 2025 | ANC", "duration_string": "2:33", "is_live": false, "was_live": false, "epoch": 1778002570, "comments": [{"id": "UgxdEQMKDNkz2qRJsSZ4AaABAg", "parent": "root", "text": "Good afternoon.  CITIZEN REPORT.  PNP HABOYBON TEAM AND CIA OPERATIVE IMPLICATE THE AFP. DUTERTES HAVE ACCESS TO THEIR EMP. 3.6.25\r\nMay this update reach you in good health, Sir/Ma’am,\r\n\r\nAt 1:25pm of 3.6.25 Subject matter is AFP:\r\n\r\nCIA operative a.k.a. German Torsten:  With smily tone said on EMP:  “Mayrong napagtestigohan si YF.”  Female provocateur within Haboybon team.\r\n\r\nPNP Junlee P. Haboybon said on EMP with crocodile tears tone:  “Napagtestigohan ni YF.”\r\n\r\nYF:  “Talagang pina experimentohan ka sa akin.”\r\n\r\nCIA MK Ultra operative and PNP Junlee P. Haboybon with his female provocateur implicate the AFP as the one who tasked them to experiment on me and/or torture me.\r\n\r\nFollow The Money:\r\n\r\nWho is paying them?  CIA MK Ultra operative a.k.a. German Torsten.\r\n\r\nWhat’s funding the PNP Haboybon team illegal operation at Purok 1-B?  The controversial Dutertes’ Confi.\r\n\r\nPNP Junlee P. Haboybon team and the CIA operative are working against the people.  This is high treason.\r\n\r\nWhy did the former PDU30 funded the PNG with only Php10 million/year during his administration and billions of pesos to fund the PNP Intel.\r\n\r\nWhy did  the AFP declare their loyalty to Marcos Jr. and refused to do a coup d’etat against Marcos Jr. for the Dutertes?\r\n\r\nThink about the W.M.D. and the EMP and the Duterte’s access to the CIA operative and PNP Haboybon’s EMP.  The way they all work together against the legit government and against the AFP military.\r\n\r\nPlease stop this atrocity.  Thank you for reading this update, Sir/Ma’am.  May God bless you", "like_count": 0, "author_id": "UCmpX-tiWxg7ohaA1m39AdTg", "author": "@JoannGarcia-c2v", "author_thumbnail": "https://yt3.ggpht.com/ytc/AIdro_nbnIwyYsF5KGzS2pWd-Bbv2zgtWKXIXYtKtnh9Q669BzQAGM9gxLELfbqgp3aEheu7BQ=s88-c-k-c0x00ffffff-no-rj", "author_is_uploader": false, "author_is_verified": false, "author_url": "https://www.youtube.com/@JoannGarcia-c2v", "is_favorited": false, "_time_text": "1 year ago", "timestamp": 1746489600, "is_pinned": false}], "asr": 44100, "format_id": "18", "format_note": "360p", "source_preference": -1, "fps": 30, "audio_channels": 2, "height": 360, "quality": 6.0, "has_drm": false, "tbr": 436.265, "filesize_approx": 8329389, "width": 640, "language_preference": -1, "ext": "mp4", "vcodec": "avc1.42001E", "acodec": "mp4a.40.2", "dynamic_range": "SDR", "url": "https://rr5---sn-ci5gup-w5pl.googlevideo.com/videoplayback?expire=1778024169&ei=iSr6ab3eMOTa9fwP2cqK4AY&ip=106.219.68.140&id=o-AHtRM7_nGK3rtEy14GnOff_tOtlRWfQw4lnm6zDj0STc&itag=18&source=youtube&requiressl=yes&xpc=EgVo2aDSNQ%3D%3D&cps=332&met=1778002569%2C&mh=lN&mm=31%2C29&mn=sn-ci5gup-w5pl%2Csn-ci5gup-qxar&ms=au%2Crdu&mv=m&mvi=5&pl=23&rms=au%2Cau&initcwndbps=1405000&bui=AbKmrwpfKCuwAsAGgj-FKPsbZEbJ-kBVOo--3szLNbkCzsSqydd5ag0Z3lNT4XtNFBb8bpg1rW4Voh3_&spc=96Xrv5FHChv7dnZ_-6NXqP4wULd8nsngl1wpuME1EDyk2pzop-IvRpkbeSEqhTX2SBw&vprv=1&svpuc=1&mime=video%2Fmp4&rqh=1&cnr=14&ratebypass=yes&dur=152.740&lmt=1760404823185070&mt=1778002184&fvip=10&fexp=51565115%2C51565682&c=ANDROID&txp=6318224&sparams=expire%2Cei%2Cip%2Cid%2Citag%2Csource%2Crequiressl%2Cxpc%2Cbui%2Cspc%2Cvprv%2Csvpuc%2Cmime%2Crqh%2Ccnr%2Cratebypass%2Cdur%2Clmt&sig=AHEqNM4wRgIhAMQpdqLsZFkBtKaOOlQUrr_CCow6iDHvHEjLzMOm_tD8AiEAk-WkVLdUyrhcIY16loW6ePcQk1SwvIUG2dXSTXHqQJc%3D&lsparams=cps%2Cmet%2Cmh%2Cmm%2Cmn%2Cms%2Cmv%2Cmvi%2Cpl%2Crms%2Cinitcwndbps&lsig=APaTxxMwRQIhAObPFPJzo5DvuAuEGbCxq0gdX0AsclM3SbGUxCYspK2JAiAKO5qT0HQpp35ifAuaSkaTBWTv