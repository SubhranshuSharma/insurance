m việc trong ngành y bảo hiểm nhân thọ.\n\nNăm 2024, 11 năm sau, phim cũ được edit lại với App Videoleap.\n\nKỹ thuật edit phim nay tốt hơn nhiều.", "channel_id": "UChwvg1Fn5uZmKPipTdNAoZQ", "channel_url": "https://www.youtube.com/channel/UChwvg1Fn5uZmKPipTdNAoZQ", "duration": 469, "view_count": 35, "age_limit": 0, "webpage_url": "https://www.youtube.com/watch?v=24a8gBSlhkw", "categories": ["Education"], "tags": [], "playable_in_embed": true, "live_status": "not_live", "media_type": "video", "_format_sort_fields": ["quality", "res", "fps", "hdr:12", "source", "vcodec", "channels", "acodec", "lang", "proto"], "automatic_captions": {}, "subtitles": {}, "like_count": 2, "channel": "Dr. QUYNHMAI NGUYEN", "channel_follower_count": 3250, "uploader": "Dr. QUYNHMAI NGUYEN", "uploader_id": "@quynhmainguyensg", "uploader_url": "https://www.youtube.com/@quynhmainguyensg", "upload_date": "20240904", "timestamp": 1725444286, "availability": "public", "webpage_url_basename": "watch", "webpage_url_domain": "youtube.com", "extractor": "youtube", "extractor_key": "Youtube", "playlist_count": 444, "playlist": "prudential insurance vietnam", "playlist_id": "prudential insurance vietnam", "playlist_title": "prudential insurance vietnam", "playlist_webpage_url": "ytsearchall:prudential insurance vietnam", "n_entries": 444, "playlist_index": 232, "display_id": "24a8gBSlhkw", "fulltitle": "KỶ NIỆM ĐẸP với PRUDENTIAL VIETNAM", "duration_string": "7:49", "is_live": false, "was_live": false, "epoch": 1778150259, "asr": 44100, "format_id": "18", "format_note": "360p", "source_preference": -1, "fps": 30, "audio_channels": 2, "height": 360, "quality": 6.0, "has_drm": false, "tbr": 535.012, "filesize_approx": 31346219, "width": 640, "language_preference": -1, "ext": "mp4", "vcodec": "avc1.42001E", "acodec": "mp4a.40.2", "dynamic_range": "SDR", "url": "https://rr4---sn-ci5gup-w5pz.googlevideo.com/videoplayback?expire=1778171858&ei=cmv8aeCTK5e_g8UP16L92Ak&ip=106.219.68.13&id=o-AJznpYkGT0_YT_nXm_9k