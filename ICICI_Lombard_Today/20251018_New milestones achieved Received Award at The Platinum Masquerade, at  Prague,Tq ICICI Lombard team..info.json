url": "https://i.ytimg.com/vi_webp/8DPq4BIWeoU/maxresdefault.webp", "preference": 0, "id": "50"}], "thumbnail": "https://i.ytimg.com/vi/8DPq4BIWeoU/maxresdefault.jpg", "description": "New milestones achieved...!\nReceived Award at The Platinum Masquerade, at Top Hotel Praha, Prague,Czech   \nThank you ICICI Lombard team.🙏🏻💐\n\nప్రగ్వే (యూరప్)దేశం లో ది ప్లాటినం మస్కరడ్ , టాప్ హోటల్ లో జరిగినఅంతర్జాతీయ ఆరోగ్య భీమా సలహదారుల సమావేశంలో ఉత్తమ ఆరోగ్య భీమా సలహాదారుగా ఎన్నికయినందున, కెరీర్‌ను అత్యుత్తమంగా  తీర్చిదిద్దుకోవడానికి, 👏వినియోగదారునుకి గొప్ప సర్విస్ ఇచ్చుటకు ఇది అత్యంత విలువైన 👌సమావేశం. వివిధ రాష్ట్రాల నుండి వచ్చిన 100 మంది మరియు అనుభవం కల ప్రఖ్యాతల మాటల నుండి ఇన్షూరెన్స్ ఏజెంట్ల బృందాలతో ఆలోచనలు, 🙌 సలహాలు మరియు భావలను పంచుకొంటు  ఉన్నతమైన ఏజెంట్గా మారడానికి, 👍వినియోగదారునికి అత్యంత కొత్త సర్విస్ అందించుటకు ఈ సమావేశం చాలా స్పూర్తిదాయకం🙏🏻💐\nThank you ICICI Lombard team🙏🏻💐\n#viral #ICICILombard#healthinsurance#ramireddysridhar #viral #lic #licofindia #jeevan #jeevanutsav #utsav #insurance #insuranceagent #agent #Sridhar #ramireddysridhar #licagent #licagents #jeevananand #jeevanlabh #jeevanumang #jeevanlakshya #endowment #pension #pension plan #pension plans #pension planning #mutual funds", "channel_id": "UC2RV_VAMax_je_tzd7cbnDw", "channel_url": "https://www.youtube.com/channel/UC2RV_VAMax_je_tzd7cbnDw", "duration": 67, "view_count": 97, "age_limit": 0, "webpage_url": "https://www.youtube.com/watch?v=8DPq4BIWeoU", "categories": ["People & Blogs"], "tags": [], "playable_in_embed": true, "live_status": "not_live", "media_type": "video", "_format_sort_fields": ["quality", "res", "fps", "hdr:12", "source", "vcodec", "channels", "acodec", "lang", "proto"], "automatic_captions": {}, "subtitles": {}, "comment_count": 8, "like_count": 13, "channel": "Ramireddy Sridhar - Insurance & Financial Guidance", "channel_follower_count": 4570, "uploader": "Ramireddy Sridhar - Insurance & Financial Guidance", "uploader_id": "@ramireddysridhar", "uploader_url": "https://www.youtube.co