i chính Prudential Việt Nam (Prudential Finance) thành lập ngày 09/10/2007 hân hạnh được cung cấp những giải pháp tài chính đáp ứng nhu cầu đa dạng của khách hàng Việt Nam.\n\nTự hào là một trong những công ty hàng đầu của ngành Bảo hiểm Nhân thọ, Prudential Việt Nam hân hạnh phục vụ hàng triệu người dân Việt Nam thông qua hệ thống hơn 218 Trung tâm Phục vụ khách hàng, Văn phòng Chi nhánh và Văn Phòng Tổng đại lý trên toàn quốc.\n\n- Bảo hiểm nhân thọ\n- bao hiem nhan tho\n- mua bảo hiểm nhân thọ\n- Đại lý bảo hiểm nhân thọ\n- Công ty bảo hiểm nhân thọ\n- lợi ích của bảo hiểm nhân thọ\n- đại lý bảo hiểm nhân thọ\n- mua bao hiem nhan tho\n- cong ty bao hiem\n- hợp đồng bảo hiểm uy tín\n- cong ty bao hiem nhan tho so 1 viet nam\n- dai ly bao hiem nhan tho xuat sac\n- hợp đồng đại lý bảo hiểm nhân thọ\n- đại lý bảo hiểm\n- Bảo hiểm doanh nghiệp\n- bảo hiểm nhân thọ tốt nhất việt nam.\n\n\nCÔNG TY TNHH BẢO HIỂM NHÂN THỌ PRUDENTIAL VIỆT NAM.\nĐịa chỉ : Tầng 25, tòa nhà Saigon Trade Center, 37 Tôn Đức Thắng, quận 1, TP.HCM\nÐT: (08) 39 101 660\nFax: (08) 39 100 899\nWebsite: http://www.prudential.com.vn/", "channel_id": "UCoBMONdym5A-ZJxS5qtAe9Q", "channel_url": "https://www.youtube.com/channel/UCoBMONdym5A-ZJxS5qtAe9Q", "duration": 112, "view_count": 1242, "age_limit": 0, "webpage_url": "https://www.youtube.com/watch?v=bNsijYEhHaw", "categories": ["People & Blogs"], "tags": ["prudential", "bảo hiểm nhân thọ prudential", "bảo hiểm prudential"], "playable_in_embed": true, "live_status": "not_live", "media_type": "video", "_format_sort_fields": ["quality", "res", "fps", "hdr:12", "source", "vcodec", "channels", "acodec", "lang", "proto"], "automatic_captions": {}, "subtitles": {}, "comment_count": 0, "channel": "Tran Muc", "channel_follower_count": 1, "uploader": "Tran Muc", "uploader_id": "@tranmuc3504", "uploader_url": "https://www.youtube.com/@tranmuc3504", "upload_date": "20170808", "timestamp": 1502166264, "availability": "public", "webpage_url_basename": "watch", "web