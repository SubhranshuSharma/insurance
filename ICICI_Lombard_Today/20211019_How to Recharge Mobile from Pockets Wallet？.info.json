oesitwork.html\n\nDownload Pockets Wallet: \nhttps://www.icicibank.com/Personal-Banking/bank-wallet/pockets/pockets.html\n\nSubscribe to the ICICI Bank YouTube Channel and remember to press the bell icon to get notifications on our latest products and services offerings. \nhttps://www.youtube.com/user/icicibank/videos?sub_confirmation=1\n\nThere is more than one way to connect with us, so be sure to check our ICICI Bank at:\nWebsite: https://www.icicibank.com\nFacebook: https://www.facebook.com/icicibank\nLinkedIn: https://in.linkedin.com/company/icici-bank\nTwitter: https://twitter.com/icicibank\"", "channel_id": "UCDsxd7FVqC4n9AiggDXHUqQ", "channel_url": "https://www.youtube.com/channel/UCDsxd7FVqC4n9AiggDXHUqQ", "duration": 76, "view_count": 1445, "age_limit": 0, "webpage_url": "https://www.youtube.com/watch?v=SDjQwPHiXkc", "categories": ["Film & Animation"], "tags": ["recharge mobile", "recharge mobile online"], "playable_in_embed": true, "live_status": "not_live", "media_type": "video", "_format_sort_fields": ["quality", "res", "fps", "hdr:12", "source", "vcodec", "channels", "acodec", "lang", "proto"], "automatic_captions": {}, "subtitles": {}, "chapters": [{"start_time": 0, "end_time": 30.0, "title": "<Untitled Chapter 1>"}, {"start_time": 30.0, "title": "CHOOSE THE DESIRED PLAN", "end_time": 41.0}, {"start_time": 41.0, "title": "SELECT THE DEBIT OPTION", "end_time": 58.0}, {"start_time": 58.0, "title": "CHECK AND CONFIRM YOUR DETAILS", "end_time": 76}], "channel": "ICICI Bank", "channel_follower_count": 346000, "uploader": "ICICI Bank", "uploader_id": "@icicibank", "uploader_url": "https://www.youtube.com/@icicibank", "upload_date": "20211019", "timestamp": 1634636443, "availability": "public", "webpage_url_basename": "watch", "webpage_url_domain": "youtube.com", "extractor": "youtube", "extractor_key": "Youtube", "playlist_count": 300, "playlist": "ICICI Lombard after:2021-06-01 before:2021-12-01", "playlist_id": "ICICI Lombard after:2021-06-01 before:2021-